{
  "name": "xrpl-stablecoin-service",
  "version": "0.1.0",
  "private": true,
  "description": "XRPL stablecoin issuance platform - REST API backend on Google Cloud Run",
  "keywords": [
    "xrpl",
    "stablecoin",
    "mptoken",
    "hono",
    "zod",
    "openapi",
    "firebase",
    "google-cloud-run",
    "typescript"
  ],
  "license": "MIT",
  "author": "chicunic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chicunic/xrpl-stablecoin-service.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "build": "rm -rf dist && tsc6 -b tsconfig.src.json && tsc-alias -p tsconfig.src.json",
    "start": "node dist/${SERVICE:-token}/index.js",
    "start:token": "node dist/token/index.js",
    "start:bank": "node dist/bank/index.js",
    "dev:token": "tsx watch src/token/index.ts",
    "dev:bank": "tsx watch src/bank/index.ts",
    "check": "tsc6 -b --noEmit && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:integration": "XRPL_NETWORK=localnet SIGNING_PROVIDER=sm vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "dependencies": {
    "@google-cloud/kms": "^6.2.1",
    "@google-cloud/pubsub": "^6.1.0",
    "@google-cloud/secret-manager": "^7.1.1",
    "@hono/node-server": "^2.1.3",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "dotenv": "^18.0.6",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.13",
    "jsqr": "^1.4.0",
    "pdf-to-img": "^7.0.0",
    "pngjs": "^7.0.0",
    "ripple-keypairs": "^3.1.0",
    "xrpl": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
